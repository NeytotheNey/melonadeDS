# Shell scripts run under bash, which breaks on CRLF line endings
*.sh text eol=lf

# The desktop's shader copies are compared with the Kotlin strings, which have LF line endings
desktop/shaders/** text eol=lf

# Patches must keep their exact bytes, or git apply fails
*.patch -text

# PGO profiles (tools/pgo/README.md) are llvm-profdata output; no line-ending conversion or text diffs
*.profdata binary
