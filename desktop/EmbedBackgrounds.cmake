# Turns the app's built-in backgrounds (app/src/main/assets/backgrounds/*.svg, the same files the APK ships) into a header the exe embeds, so
# the release folder needs no assets next to it and the desktop's copies can't drift from the app's. Run by CMakeLists.txt at build time:
# cmake -DBACKGROUND_DIR=... -DOUTPUT=... -P EmbedBackgrounds.cmake
file(GLOB BACKGROUND_FILES RELATIVE "${BACKGROUND_DIR}" "${BACKGROUND_DIR}/*.svg")
list(SORT BACKGROUND_FILES)
if (NOT BACKGROUND_FILES)
    message(FATAL_ERROR "no backgrounds in ${BACKGROUND_DIR}")
endif()

set(CONTENT "// generated by desktop/EmbedBackgrounds.cmake from app/src/main/assets/backgrounds; don't edit\n#pragma once\n\n")
set(TABLE "")
set(INDEX 0)
foreach (NAME IN LISTS BACKGROUND_FILES)
    file(READ "${BACKGROUND_DIR}/${NAME}" HEX HEX)
    # every byte as 0xNN, then a 0 so the text ends there
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX}")
    string(APPEND CONTENT "static const unsigned char BACKGROUND_FILE_${INDEX}[] = {${BYTES}0};\n")
    string(APPEND TABLE "    {\"${NAME}\", BACKGROUND_FILE_${INDEX}, sizeof(BACKGROUND_FILE_${INDEX}) - 1},\n")
    math(EXPR INDEX "${INDEX} + 1")
endforeach()
string(APPEND CONTENT "\nstatic const EmbeddedBackgroundFile EMBEDDED_BACKGROUND_FILES[] = {\n${TABLE}};\n")

# written only when it changed, so an unchanged folder doesn't rebuild what includes it
if (EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" OLD)
endif()
if (NOT "${OLD}" STREQUAL "${CONTENT}")
    file(WRITE "${OUTPUT}" "${CONTENT}")
endif()
