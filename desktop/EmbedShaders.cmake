# Turns desktop/shaders (the app's shaders, exported by DesktopShaderExportTest, see desktop/README.md) into a header the exe embeds, so it needs
# no shader files next to it. Run by CMakeLists.txt at build time: cmake -DSHADER_DIR=... -DOUTPUT=... -P EmbedShaders.cmake
file(GLOB SHADER_FILES RELATIVE "${SHADER_DIR}" "${SHADER_DIR}/*.vert" "${SHADER_DIR}/*.frag" "${SHADER_DIR}/shaders.json")
list(SORT SHADER_FILES)
if (NOT SHADER_FILES)
    message(FATAL_ERROR "no shaders in ${SHADER_DIR}")
endif()

set(CONTENT "// generated by desktop/EmbedShaders.cmake from desktop/shaders; don't edit\n#pragma once\n\n")
set(TABLE "")
set(INDEX 0)
foreach (NAME IN LISTS SHADER_FILES)
    file(READ "${SHADER_DIR}/${NAME}" HEX HEX)
    # every byte as 0xNN, then a 0 so the text ends there
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX}")
    string(APPEND CONTENT "static const unsigned char SHADER_FILE_${INDEX}[] = {${BYTES}0};\n")
    string(APPEND TABLE "    {\"${NAME}\", SHADER_FILE_${INDEX}, sizeof(SHADER_FILE_${INDEX}) - 1},\n")
    math(EXPR INDEX "${INDEX} + 1")
endforeach()
string(APPEND CONTENT "\nstatic const EmbeddedShaderFile EMBEDDED_SHADER_FILES[] = {\n${TABLE}};\n")

# written only when it changed, so an unchanged export doesn't rebuild what includes it
if (EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" OLD)
endif()
if (NOT "${OLD}" STREQUAL "${CONTENT}")
    file(WRITE "${OUTPUT}" "${CONTENT}")
endif()
