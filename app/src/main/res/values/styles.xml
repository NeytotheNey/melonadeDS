<resources>
    <!-- Shared by AppTheme and EmulatorTheme. These colours are used when dynamic colours are not available or are disabled -->
    <style name="Base.AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/m3Primary</item>
        <item name="colorOnPrimary">@color/m3OnPrimary</item>
        <item name="colorPrimaryContainer">@color/m3PrimaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/m3OnPrimaryContainer</item>
        <item name="colorPrimaryInverse">@color/m3InversePrimary</item>
        <item name="colorSecondary">@color/m3Secondary</item>
        <item name="colorOnSecondary">@color/m3OnSecondary</item>
        <item name="colorSecondaryContainer">@color/m3SecondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/m3OnSecondaryContainer</item>
        <item name="colorTertiary">@color/m3Tertiary</item>
        <item name="colorOnTertiary">@color/m3OnTertiary</item>
        <item name="colorTertiaryContainer">@color/m3TertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/m3OnTertiaryContainer</item>
        <item name="colorError">@color/m3Error</item>
        <item name="colorOnError">@color/m3OnError</item>
        <item name="colorErrorContainer">@color/m3ErrorContainer</item>
        <item name="colorOnErrorContainer">@color/m3OnErrorContainer</item>
        <item name="android:colorBackground">@color/m3Background</item>
        <item name="colorOnBackground">@color/m3OnBackground</item>
        <item name="colorSurface">@color/m3Surface</item>
        <item name="colorOnSurface">@color/m3OnSurface</item>
        <item name="colorSurfaceVariant">@color/m3SurfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/m3OnSurfaceVariant</item>
        <item name="colorSurfaceInverse">@color/m3InverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/m3InverseOnSurface</item>
        <item name="colorOutline">@color/m3Outline</item>
        <item name="colorOutlineVariant">@color/m3OutlineVariant</item>
        <item name="colorSurfaceBright">@color/m3SurfaceBright</item>
        <item name="colorSurfaceDim">@color/m3SurfaceDim</item>
        <item name="colorSurfaceContainerLowest">@color/m3SurfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/m3SurfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/m3SurfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/m3SurfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/m3SurfaceContainerHighest</item>
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="android:colorAccent">?attr/colorPrimary</item>
    </style>

    <style name="AppTheme" parent="Base.AppTheme">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">@bool/lightNavigationBar</item>
        <item name="toolbarNavigationButtonStyle">@style/Toolbar.Button.Navigation</item>
        <item name="actionOverflowMenuStyle">@style/Menu.OverflowUnder</item>
        <item name="preferenceTheme">@style/ThemeOverlay.MelonDS.Preference</item>
    </style>

    <!-- Applied on top of the activity theme by DynamicColors when dynamic colours are enabled -->
    <style name="ThemeOverlay.MelonDS.DynamicColors" parent="ThemeOverlay.Material3.DynamicColors.DayNight">
        <item name="melonDynamicColorsApplied">true</item>
    </style>

    <style name="SplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splashBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo_splash</item>

        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

    <style name="EmulatorTheme" parent="Base.AppTheme">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <!-- Used when the "Show status bar" setting is on. The status bar is drawn over the game, so keep it clear with light icons -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Matches the Compose M3 TopAppBar: surface coloured, no elevation -->
    <style name="Toolbar" parent="Widget.Material3.Toolbar.Surface">
        <item name="titleTextAppearance">@style/Toolbar.TitleText</item>
    </style>

    <style name="Toolbar.Button.Navigation" parent="Widget.AppCompat.Toolbar.Button.Navigation">
        <item name="tint">?attr/colorOnSurface</item>
    </style>

    <style name="Toolbar.TitleText" parent="TextAppearance.Material3.TitleLarge" />

    <style name="FullscreenDialog">
        <item name="android:windowEnterAnimation">@anim/dialog_slide_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_slide_out</item>
    </style>

    <style name="FullscreenDialog.Restore">
        <item name="android:windowEnterAnimation">@null</item>
    </style>

    <!-- Not named "Preference", which would replace the base style of the preference library's own Preference.* styles -->
    <style name="ThemeOverlay.MelonDS.Preference" parent="@style/PreferenceThemeOverlay">
        <item name="preferenceStyle">@style/PreferenceCard</item>
        <item name="preferenceCategoryStyle">@style/PreferenceCard.Category</item>
        <item name="dialogPreferenceStyle">@style/PreferenceCard.Dialog</item>
        <item name="editTextPreferenceStyle">@style/PreferenceCard.EditText</item>
        <item name="switchPreferenceStyle">@style/Preference.SwitchPreference.MaterialSwitch</item>
    </style>

    <!-- Settings rows drawn as grouped cards. The row layouts set the card background and PreferenceCardDecoration rounds its corners.
         The rows have no icons, so no space is kept for one -->
    <style name="PreferenceCard" parent="@style/Preference.Material">
        <item name="android:layout">@layout/preference_card</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="PreferenceCard.Category" parent="@style/Preference.Category.Material">
        <item name="android:layout">@layout/preference_category_card</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>

    <style name="PreferenceCard.Dialog" parent="@style/Preference.DialogPreference.Material">
        <item name="android:layout">@layout/preference_card</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="PreferenceCard.EditText" parent="@style/Preference.DialogPreference.EditTextPreference.Material">
        <item name="android:layout">@layout/preference_card</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <!-- Use M3 switches in the preference screens. The ids must match the ones expected by SwitchPreference -->
    <style name="Preference.SwitchPreference.MaterialSwitch" parent="@style/Preference.SwitchPreference.Material">
        <item name="android:layout">@layout/preference_card</item>
        <item name="android:widgetLayout">@layout/preference_widget_material_switch</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="Button.Ripple.Small" parent="android:Widget.ImageButton">
        <item name="android:background">@drawable/drawable_ripple_small</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- Icon buttons in the layout editor's item controls. Their icons are tinted in code -->
    <style name="Button.EditorIcon" parent="android:Widget.ImageButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="Button.EditorChoice" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="LayoutEditorPanelRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- Label and value of a slider. Tapping them opens a dialog to type the value, when that's supported -->
    <style name="LayoutEditorPanelValueLabels">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">2dp</item>
    </style>

    <style name="LayoutEditorPanelText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/textLayoutEditor</item>
    </style>

    <style name="LayoutEditorPanelSeekBar">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:paddingVertical">12dp</item>
    </style>

    <style name="Button.Birthday" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>

    <style name="Menu.OverflowUnder" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="overlapAnchor">false</item>
        <item name="android:overlapAnchor">false</item>
    </style>

    <style name="Text.SaveStateSlot" parent="Widget.AppCompat.TextView">
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="ColourTile">
        <item name="android:background">@drawable/color_picker_tile_background</item>
        <item name="android:foreground">@drawable/color_picker_selector</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
