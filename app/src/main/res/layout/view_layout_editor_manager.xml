<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <ImageView
        android:id="@+id/image_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null" />

    <me.magnum.melonds.ui.layouteditor.LayoutEditorView
        android:id="@+id/view_layout_editor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false" />

    <!-- Holds the item panel inside the display cutout insets (set as padding in code). Touches outside the panel go through to the editor -->
    <FrameLayout
        android:id="@+id/layout_item_panel_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <me.magnum.melonds.ui.layouteditor.LayoutEditorPanelScrollView
            android:id="@+id/layout_item_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="8dp"
            android:background="@drawable/bg_layout_editor_panel"
            android:clickable="true"
            android:focusable="false"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_item_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="@color/textLayoutEditor"
                        tools:text="Top Screen" />

                    <ImageButton
                        android:id="@+id/button_panel_collapse"
                        style="@style/Button.EditorIcon"
                        android:contentDescription="@string/layout_editor_show_fewer_options"
                        android:src="@drawable/ic_close_fullscreen" />

                    <ImageButton
                        android:id="@+id/button_panel_done"
                        style="@style/Button.EditorIcon"
                        android:background="@drawable/bg_layout_editor_accent_button"
                        android:contentDescription="@string/done"
                        android:src="@drawable/ic_check" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_size_row"
                    style="@style/LayoutEditorPanelRow">

                    <LinearLayout
                        android:id="@+id/layout_size_labels"
                        style="@style/LayoutEditorPanelValueLabels">

                        <TextView
                            style="@style/LayoutEditorPanelText"
                            android:text="@string/label_size" />

                        <TextView
                            android:id="@+id/text_size"
                            style="@style/LayoutEditorPanelText"
                            tools:text="1080" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seek_bar_size"
                        style="@style/LayoutEditorPanelSeekBar" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_width_row"
                    style="@style/LayoutEditorPanelRow">

                    <LinearLayout
                        android:id="@+id/layout_width_labels"
                        style="@style/LayoutEditorPanelValueLabels">

                        <TextView
                            style="@style/LayoutEditorPanelText"
                            android:text="@string/label_width" />

                        <TextView
                            android:id="@+id/text_width"
                            style="@style/LayoutEditorPanelText"
                            tools:text="1080" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seek_bar_width"
                        style="@style/LayoutEditorPanelSeekBar" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_height_row"
                    style="@style/LayoutEditorPanelRow">

                    <LinearLayout
                        android:id="@+id/layout_height_labels"
                        style="@style/LayoutEditorPanelValueLabels">

                        <TextView
                            style="@style/LayoutEditorPanelText"
                            android:text="@string/label_height" />

                        <TextView
                            android:id="@+id/text_height"
                            style="@style/LayoutEditorPanelText"
                            tools:text="810" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seek_bar_height"
                        style="@style/LayoutEditorPanelSeekBar" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggle_group_aspect_ratio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginVertical="2dp"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_aspect_ratio_4_3"
                        style="@style/Button.EditorChoice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/layout_editor_aspect_ratio_4_3" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_aspect_ratio_16_9"
                        style="@style/Button.EditorChoice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/layout_editor_aspect_ratio_16_9" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_aspect_ratio_free"
                        style="@style/Button.EditorChoice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/layout_editor_aspect_ratio_free" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <LinearLayout
                    android:id="@+id/layout_scale_shortcuts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginVertical="2dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_scale_1x"
                        style="@style/Button.EditorChoice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        tools:text="1x" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_scale_2x"
                        style="@style/Button.EditorChoice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        tools:text="2x" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_scale_3x"
                        style="@style/Button.EditorChoice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        tools:text="3x" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_scale_fit"
                        style="@style/Button.EditorChoice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/layout_editor_scale_fit" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_opacity_row"
                    style="@style/LayoutEditorPanelRow">

                    <LinearLayout style="@style/LayoutEditorPanelValueLabels">

                        <TextView
                            style="@style/LayoutEditorPanelText"
                            android:text="@string/layout_editor_opacity" />

                        <TextView
                            android:id="@+id/text_opacity"
                            style="@style/LayoutEditorPanelText"
                            tools:text="100%" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seek_bar_opacity"
                        style="@style/LayoutEditorPanelSeekBar"
                        android:max="100" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_above_screen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:paddingHorizontal="8dp"
                    android:drawablePadding="8dp"
                    android:drawableStart="@drawable/ic_layers"
                    android:text="@string/above_other_screen"
                    android:textColor="@color/textLayoutEditor" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/button_panel_center_horizontal"
                        style="@style/Button.EditorIcon"
                        android:contentDescription="@string/center_horizontal"
                        android:src="@drawable/ic_align_horizontal_center" />

                    <ImageButton
                        android:id="@+id/button_panel_center_vertical"
                        style="@style/Button.EditorIcon"
                        android:contentDescription="@string/center_vertical"
                        android:src="@drawable/ic_align_vertical_center" />

                    <ImageButton
                        android:id="@+id/button_move_left"
                        style="@style/Button.EditorIcon"
                        android:contentDescription="@string/layout_editor_move_left"
                        android:src="@drawable/ic_arrow_left" />

                    <ImageButton
                        android:id="@+id/button_move_up"
                        style="@style/Button.EditorIcon"
                        android:contentDescription="@string/layout_editor_move_up"
                        android:src="@drawable/ic_arrow_up" />

                    <ImageButton
                        android:id="@+id/button_move_down"
                        style="@style/Button.EditorIcon"
                        android:contentDescription="@string/layout_editor_move_down"
                        android:src="@drawable/ic_arrow_down" />

                    <ImageButton
                        android:id="@+id/button_move_right"
                        style="@style/Button.EditorIcon"
                        android:contentDescription="@string/layout_editor_move_right"
                        android:src="@drawable/ic_arrow_right" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/button_panel_delete"
                        style="@style/Button.EditorIcon"
                        android:contentDescription="@string/delete"
                        android:src="@drawable/ic_delete" />
                </LinearLayout>
            </LinearLayout>
        </me.magnum.melonds.ui.layouteditor.LayoutEditorPanelScrollView>
    </FrameLayout>

    <!-- Compact toolbar shown next to the selected item. Its position is set in code -->
    <LinearLayout
        android:id="@+id/layout_item_pill"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:background="@drawable/bg_layout_editor_pill"
        android:clickable="true"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageButton
            android:id="@+id/button_pill_smaller"
            style="@style/Button.EditorIcon"
            android:contentDescription="@string/layout_editor_make_smaller"
            android:src="@drawable/ic_remove" />

        <ImageButton
            android:id="@+id/button_pill_bigger"
            style="@style/Button.EditorIcon"
            android:contentDescription="@string/layout_editor_make_bigger"
            android:src="@drawable/ic_add" />

        <ImageButton
            android:id="@+id/button_pill_center_horizontal"
            style="@style/Button.EditorIcon"
            android:contentDescription="@string/center_horizontal"
            android:src="@drawable/ic_align_horizontal_center" />

        <ImageButton
            android:id="@+id/button_pill_delete"
            style="@style/Button.EditorIcon"
            android:contentDescription="@string/delete"
            android:src="@drawable/ic_delete" />

        <ImageButton
            android:id="@+id/button_pill_expand"
            style="@style/Button.EditorIcon"
            android:contentDescription="@string/layout_editor_show_all_options"
            android:src="@drawable/ic_open_in_full" />

        <ImageButton
            android:id="@+id/button_pill_done"
            style="@style/Button.EditorIcon"
            android:background="@drawable/bg_layout_editor_accent_button"
            android:contentDescription="@string/done"
            android:src="@drawable/ic_check" />
    </LinearLayout>

    <!-- Always visible menu button. Kept as the last child so it draws above everything else. Its position is set in code -->
    <ImageButton
        android:id="@+id/button_floating_menu"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_layout_editor_floating_button"
        android:src="@drawable/ic_menu"
        android:scaleType="center"
        android:alpha="0.6"
        android:contentDescription="@string/layout_editor_open_menu" />
</RelativeLayout>
