<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory
            android:key="category_display_3d_rendering"
            android:title="@string/settings_section_renderer">

        <ListPreference
                android:key="video_renderer"
                android:title="@string/renderer"
                android:summary="%s"
                android:entries="@array/video_renderer_options"
                android:entryValues="@array/video_renderer_values"
                android:defaultValue="software"/>

        <!-- OpenGL and compute only, so it's hidden for software (set up in VideoPreferencesFragment) -->
        <ListPreference
                android:key="video_internal_resolution"
                android:title="@string/internal_resolution"
                android:summary="%s"
                android:entries="@array/video_internal_resolution_options"
                android:entryValues="@array/video_internal_resolution_values"
                android:defaultValue="1"/>
    </PreferenceCategory>

    <!-- All OpenGL and compute only, so the section is hidden for software (set up in VideoPreferencesFragment) -->
    <PreferenceCategory
            android:key="category_display_enhancements"
            android:title="@string/settings_section_enhancements">

        <SwitchPreference
                android:key="video_hires_capture"
                android:title="@string/hires_capture"
                android:summary="@string/hires_capture_summary"
                android:defaultValue="true" />

        <SwitchPreference
                android:key="video_filter_2d"
                android:title="@string/filter_2d"
                android:summary="@string/filter_2d_summary"
                android:defaultValue="false" />

        <SwitchPreference
                android:key="video_sharper_rotated_2d"
                android:title="@string/sharper_rotated_2d"
                android:summary="@string/sharper_rotated_2d_summary"
                android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_section_accuracy">

        <!-- OpenGL and compute only (software always draws it), so it's hidden for software (set up in VideoPreferencesFragment) -->
        <SwitchPreference
                android:key="video_edge_marking"
                android:title="@string/edge_marking"
                android:summary="@string/edge_marking_summary"
                android:defaultValue="true" />

        <!-- OpenGL only (GPU::GLSeams), so it's grayed out for software and compute (set up in VideoPreferencesFragment) -->
        <SwitchPreference
                android:key="video_gl_seams"
                android:title="@string/gl_seams"
                android:summary="@string/gl_seams_summary"
                android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_section_image">

        <ListPreference
                android:key="video_filtering"
                android:title="@string/filter"
                android:summary="%s"
                android:entries="@array/video_filtering_options"
                android:entryValues="@array/video_filtering_values"
                android:defaultValue="none"/>

        <!-- Also turns on the compute renderer's dithering (RendererConfiguration.colorDithering), which had its own switch before -->
        <SwitchPreference
                android:key="video_deband"
                android:title="@string/deband"
                android:summary="@string/deband_summary"
                android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_section_frame_pacing">

        <SwitchPreference
                android:key="frame_pacing_vsync"
                android:title="@string/frame_pacing_vsync"
                android:summary="@string/frame_pacing_vsync_summary"
                android:defaultValue="true" />

        <SwitchPreference
                android:key="frame_pacing_lock_60hz"
                android:title="@string/frame_pacing_lock_60hz"
                android:summary="@string/frame_pacing_lock_60hz_summary"
                android:defaultValue="true" />

        <SwitchPreference
                android:key="frame_pacing_buffer"
                android:title="@string/frame_pacing_buffer"
                android:summary="@string/frame_pacing_buffer_summary"
                android:dependency="frame_pacing_vsync"
                android:defaultValue="true" />

        <!-- OpenGL and compute only, so it's grayed out for software (set up in VideoPreferencesFragment) -->
        <SwitchPreference
                android:key="frame_pacing_smooth_30fps"
                android:title="@string/frame_pacing_smooth_30fps"
                android:summary="@string/frame_pacing_smooth_30fps_summary"
                android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_section_on_screen_info">

        <ListPreference
                android:key="fps_counter_position"
                android:title="@string/fps_counter_position"
                android:summary="%s"
                android:entries="@array/fps_counter_position_options"
                android:entryValues="@array/fps_counter_position_values"
                android:defaultValue="hidden" />

        <SwitchPreference
                android:key="show_status_bar"
                android:title="@string/show_status_bar"
                android:summary="@string/show_status_bar_summary"
                android:defaultValue="false" />
    </PreferenceCategory>
</PreferenceScreen>
