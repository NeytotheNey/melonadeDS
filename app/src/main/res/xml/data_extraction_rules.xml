<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. With only excludes here, everything else is still backed up and transferred as before. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ra_web_api_key.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ra_web_api_key.xml" />
    </device-transfer>
</data-extraction-rules>
