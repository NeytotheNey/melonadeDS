<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools">

    <PreferenceCategory android:title="@string/settings_section_save_files">

        <SwitchPreference
                android:key="use_rom_dir"
                android:title="@string/save_next_rom"
                android:defaultValue="true"
                android:disableDependentsState="true" />

        <me.magnum.melonds.ui.settings.preferences.StoragePickerPreference
                android:key="sram_dir"
                android:title="@string/save_file_directory"
                android:dependency="use_rom_dir" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_section_save_states">

        <ListPreference
                android:key="save_state_location"
                android:title="@string/save_state_location"
                android:summary="%s"
                android:entries="@array/save_state_locations"
                android:entryValues="@array/save_state_location_values"
                android:defaultValue="save_dir" />

        <SwitchPreference
                android:key="video_lua_drawings_in_state_pictures"
                android:title="@string/lua_drawings_in_state_pictures"
                android:summary="@string/lua_drawings_in_state_pictures_summary"
                android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/rewind">

        <SwitchPreference
                android:key="enable_rewind"
                android:title="@string/rewind"
                android:summaryOff="@string/rewind_description"
                android:defaultValue="false" />

        <!-- Each step represents 1 second -->
        <me.magnum.melonds.ui.settings.preferences.SliderPreference
                android:key="rewind_period"
                android:title="@string/rewind_save_period"
                android:dependency="enable_rewind"
                app:min="1"
                android:max="60"
                android:defaultValue="10"
                app:updatesContinuously="true" />

        <!-- Each step represents 10 seconds. Min: 10 sec, max: 5 min. Default: 1 min -->
        <me.magnum.melonds.ui.settings.preferences.SliderPreference
                android:key="rewind_window"
                android:title="@string/rewind_length"
                android:dependency="enable_rewind"
                app:min="1"
                android:max="30"
                android:defaultValue="6"
                app:updatesContinuously="true" />

        <!--Only used to display information (max. memory usage) -->
        <Preference
                android:key="rewind_info"
                android:dependency="enable_rewind"
                android:selectable="false"
                tools:summary="Max. memory usage: 100MB" />

        <ListPreference
                android:key="rewind_window_position"
                android:title="@string/rewind_window_position"
                android:dependency="enable_rewind"
                android:summary="%s"
                android:entries="@array/rewind_window_position_options"
                android:entryValues="@array/rewind_window_position_values"
                android:defaultValue="bottom" />
    </PreferenceCategory>
</PreferenceScreen>
