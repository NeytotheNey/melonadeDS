<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/settings_section_account">

        <Preference
            android:key="ra_login"
            android:title="@string/login_with_retro_achievements" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_section_gameplay">

        <SwitchPreference
            android:key="ra_hardcore_enabled"
            android:title="@string/hardcore_mode"
            android:summary="@string/hardcore_mode_summary"
            android:dependency="ra_login"
            android:defaultValue="false" />

        <SwitchPreference
            android:key="ra_rich_presence"
            android:title="@string/enable_rich_presence"
            android:summary="@string/rich_presence_summary"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_section_on_screen_indicators">

        <SwitchPreference
            android:key="ra_active_challenge_indicators"
            android:title="@string/show_active_challenge_indicators"
            android:summary="@string/show_active_challenge_indicators_summary"
            android:dependency="ra_login"
            android:defaultValue="true" />

        <SwitchPreference
            android:key="ra_progress_indicators"
            android:title="@string/show_progress_indicators"
            android:summary="@string/show_progress_indicators_summary"
            android:dependency="ra_login"
            android:defaultValue="true" />

        <SwitchPreference
            android:key="ra_leaderboard_indicators"
            android:title="@string/show_leaderboard_indicators"
            android:summary="@string/show_leaderboard_indicators_summary"
            android:dependency="ra_login"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_section_game_library">

        <Preference
            android:key="ra_web_api_key"
            android:title="@string/ra_web_api_key"
            android:persistent="false" />

        <Preference
            android:key="ra_web_api_key_remove"
            android:title="@string/ra_web_api_key_remove"
            app:isPreferenceVisible="false" />

        <Preference
            android:key="ra_refresh_metadata"
            android:title="@string/ra_refresh_metadata"
            android:summary="@string/ra_refresh_metadata_summary" />

        <Preference
            android:key="ra_clear_art"
            android:title="@string/ra_clear_art"
            android:summary="@string/ra_clear_art_summary" />
    </PreferenceCategory>
</PreferenceScreen>
