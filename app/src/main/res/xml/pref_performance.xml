<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/settings_section_emulation">

        <SwitchPreference
                android:key="enable_jit"
                android:title="@string/enable_jit"
                android:summary="@string/enable_jit_summary"
                android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_section_threading">

        <!-- Only used by the software renderer, so it's turned off for the others (set up in PerformancePreferencesFragment) -->
        <SwitchPreference
                android:key="enable_threaded_rendering"
                android:title="@string/threaded_rendering"
                android:summary="@string/threaded_rendering_summary"
                android:defaultValue="true" />

        <SwitchPreference
                android:key="video_threaded_2d"
                android:title="@string/threaded_2d_rendering"
                android:summary="@string/threaded_2d_rendering_summary"
                android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory
            android:key="category_performance_device"
            android:title="@string/settings_section_device">

        <SwitchPreference
                android:key="enable_sustained_performance"
                android:title="@string/sustained_performance_mode"
                android:summary="@string/sustained_performance_mode_summary"
                android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_section_speed">

        <ListPreference
                android:key="fast_forward_speed_multiplier"
                android:title="@string/fast_forward_max_speed"
                android:summary="%s"
                android:entries="@array/fast_forward_speed_multiplier_options"
                android:entryValues="@array/fast_forward_speed_multiplier_values"
                android:defaultValue="-1" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_section_diagnostics">

        <SwitchPreference
                android:key="enable_perf_logging"
                android:title="@string/performance_logging"
                android:summary="@string/performance_logging_summary"
                android:defaultValue="false" />

        <SwitchPreference
                android:key="enable_debug_log"
                android:title="@string/debug_log"
                android:summary="@string/debug_log_summary"
                android:defaultValue="false" />

        <!-- Enabled while either log is on (set up in PerformancePreferencesFragment) -->
        <me.magnum.melonds.ui.settings.preferences.StoragePickerPreference
                android:key="perf_log_dir"
                android:title="@string/performance_log_directory" />

        <!-- Debug builds only: hidden in release builds by PerformancePreferencesFragment, and never applied there -->
        <EditTextPreference
                android:key="debug_switches"
                android:title="@string/debug_switches"
                android:dialogMessage="@string/debug_switches_dialog_message"
                android:defaultValue=""
                app:isPreferenceVisible="false" />
    </PreferenceCategory>
</PreferenceScreen>
