<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/settings_section_firmware">

        <Preference
                android:title="@string/internal_firmware_settings"
                android:summary="@string/internal_firmware_settings_summary"
                android:widgetLayout="@layout/preference_widget_chevron"
                android:fragment="me.magnum.melonds.ui.settings.fragments.FirmwarePreferencesFragment" />

        <Preference
                android:title="@string/custom_bios_firmware"
                android:summary="@string/custom_bios_firmware_summary"
                android:widgetLayout="@layout/preference_widget_chevron"
                android:fragment="me.magnum.melonds.ui.settings.fragments.CustomFirmwarePreferencesFragment" />

        <SwitchPreference
                android:key="sync_rtc_to_device"
                android:title="@string/sync_rtc_to_device"
                android:summary="@string/sync_rtc_to_device_summary"
                android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_section_dsi_camera">

        <ListPreference
                android:key="dsi_camera_source"
                android:title="@string/dsi_camera_source"
                android:summary="%s"
                android:entries="@array/dsi_camera_source_options"
                android:entryValues="@array/dsi_camera_source_values"
                android:defaultValue="physical_cameras" />

        <me.magnum.melonds.ui.settings.preferences.StoragePickerPreference
                android:key="dsi_camera_static_image"
                android:title="@string/dsi_camera_image"
                android:dependency="dsi_camera_source"
                app:type="file"
                app:permissions="read"
                app:mimeType="image/jpeg|image/png" />
    </PreferenceCategory>
</PreferenceScreen>
