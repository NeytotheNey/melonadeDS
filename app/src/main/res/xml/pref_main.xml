<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/settings_group_play">

        <Preference
                android:layout="@layout/preference_top_level"
                android:title="@string/settings_display"
                android:summary="@string/settings_display_summary"
                app:icon="@drawable/ic_settings_display"
                android:fragment="me.magnum.melonds.ui.settings.fragments.VideoPreferencesFragment" />

        <Preference
                android:layout="@layout/preference_top_level"
                android:title="@string/settings_controls"
                android:summary="@string/settings_controls_summary"
                app:icon="@drawable/ic_settings_controls"
                android:fragment="me.magnum.melonds.ui.settings.fragments.InputPreferencesFragment" />

        <Preference
                android:layout="@layout/preference_top_level"
                android:title="@string/category_audio"
                android:summary="@string/settings_audio_summary"
                app:icon="@drawable/ic_settings_audio"
                android:fragment="me.magnum.melonds.ui.settings.fragments.AudioPreferencesFragment" />

        <Preference
                android:layout="@layout/preference_top_level"
                android:title="@string/settings_performance"
                android:summary="@string/settings_performance_summary"
                app:icon="@drawable/ic_settings_performance"
                android:fragment="me.magnum.melonds.ui.settings.fragments.PerformancePreferencesFragment" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_group_games_and_saves">

        <Preference
                android:layout="@layout/preference_top_level"
                android:title="@string/settings_game_library"
                android:summary="@string/settings_game_library_summary"
                app:icon="@drawable/ic_settings_library"
                android:fragment="me.magnum.melonds.ui.settings.fragments.RomsPreferencesFragment" />

        <Preference
                android:layout="@layout/preference_top_level"
                android:title="@string/settings_saves_and_rewind"
                android:summary="@string/settings_saves_and_rewind_summary"
                app:icon="@drawable/ic_settings_saves"
                android:fragment="me.magnum.melonds.ui.settings.fragments.SaveFilesPreferencesFragment" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_group_extras">

        <Preference
                android:layout="@layout/preference_top_level"
                android:title="@string/retroachievements"
                android:summary="@string/settings_retroachievements_summary"
                app:icon="@drawable/ic_settings_trophy"
                android:fragment="me.magnum.melonds.ui.settings.fragments.RetroAchievementsPreferencesFragment" />

        <Preference
                android:layout="@layout/preference_top_level"
                android:title="@string/cheats"
                android:summary="@string/settings_cheats_summary"
                app:icon="@drawable/ic_settings_cheats"
                android:fragment="me.magnum.melonds.ui.settings.fragments.CheatsPreferencesFragment" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_group_system">

        <Preference
                android:layout="@layout/preference_top_level"
                android:title="@string/settings_bios_and_firmware"
                android:summary="@string/settings_bios_and_firmware_summary"
                app:icon="@drawable/ic_settings_bios"
                android:fragment="me.magnum.melonds.ui.settings.fragments.SystemPreferencesFragment" />

        <Preference
                android:layout="@layout/preference_top_level"
                android:title="@string/settings_appearance_and_backup"
                android:summary="@string/settings_appearance_and_backup_summary"
                app:icon="@drawable/ic_settings_appearance"
                android:fragment="me.magnum.melonds.ui.settings.fragments.AppearancePreferencesFragment" />

        <Preference
                android:layout="@layout/preference_top_level"
                android:title="@string/settings_about"
                android:summary="@string/settings_about_summary"
                app:icon="@drawable/ic_settings_about"
                android:fragment="me.magnum.melonds.ui.settings.fragments.AboutFragment" />
    </PreferenceCategory>
</PreferenceScreen>
