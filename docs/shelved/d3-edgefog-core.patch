+#ifdef EdgeFog
+// GPU::GLFinalPass bit 0 (D3, GLRenderer::RenderSceneChunk): the edge and fog passes in one draw,
+// built from this source with EdgeFog defined and GL_EXT_blend_func_extended. the blend is
+// result = oColor * oFactor + dst * (1 - oFactor) per channel (SRC1_COLOR, ONE_MINUS_SRC1_COLOR and
+// the _ALPHA ones), which is each pass's own blend where only one of them changes a pixel. where
+// both do (an edge-marked pixel with the fog flag, fog on the color too), the edge pass's 8-bit
+// store before the fog is redone here for an edge alpha of 1 and skipped for antialiasing's 0.5
+// (that one needs the destination), so those pixels can be a step off. alpha is the fog pass's,
+// edge marking doesn't change it
+layout(location = 0, index = 0) out vec4 oColor;
+layout(location = 0, index = 1) out vec4 oFactor;
+// DISP3DCNT bit 6: fog changes alpha only
+uniform int uFogAlphaOnly;
+
+// kFinalPassFogFS's CalculateFog
+float FogDensity(float depth)
+{
+    int idepth = int(depth * 16777216.0);
+    int densityid, densityfrac;
+
+    if (idepth < uFogOffset)
+    {
+        densityid = 0;
+        densityfrac = 0;
+    }
+    else
+    {
+        uint udepth = uint(idepth);
+        udepth -= uint(uFogOffset);
+        udepth = (udepth >> 2) << uint(uFogShift);
+
+        densityid = int(udepth >> 17);
+        if (densityid >= 32)
+        {
+            densityid = 32;
+            densityfrac = 0;
+        }
+        else
+            densityfrac = int(udepth & uint(0x1FFFF));
+    }
+
+    return mix(uFogDensity[densityid], uFogDensity[densityid+1], float(densityfrac)/131072.0);
+}
+#else
 layout(location = 0) out vec4 oColor;
+#endif
 
