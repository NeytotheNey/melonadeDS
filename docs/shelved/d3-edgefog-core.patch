+// GPU::GLFinalPass bit 0 (D3): the combined edge and fog program, built the first frame that wants
+// it. false without GL_EXT_blend_func_extended or when it doesn't build (logged once): the frame
+// draws the two passes as before
+bool GLRenderer::PrepareEdgeFogShader()
+{
+    if (FinalPassEdgeFogShader)
+        return true;
+    if (!HasDualSource || EdgeFogTried)
+        return false;
+    EdgeFogTried = true;
+
+    std::string fs = kFinalPassEdgeFS;
+    fs.insert(strlen(kShaderHeader), "\n#extension GL_EXT_blend_func_extended : require\n#define EdgeFog");
+    GLuint prog = 0;
+    if (!OpenGL::CompileVertexFragmentProgram(prog, kFinalPassVS, fs, "FinalPassEdgeFogShader", {{"vPosition", 0}}, {}))
+    {
+        glDeleteProgram(prog);
+        Platform::Log(Platform::LogLevel::Warn, "GLFINALPASS: the combined edge and fog program didn't build, glfinalpass 1 draws two passes\n");
+        return false;
+    }
+    glUniformBlockBinding(prog, glGetUniformBlockIndex(prog, "uConfig"), 0);
+    glUseProgram(prog);
+    glUniform1i(glGetUniformLocation(prog, "DepthBuffer"), 0);
+    glUniform1i(glGetUniformLocation(prog, "AttrBuffer"), 1);
+    const char* names[6] = {"uEdgeScale", "uDepthUnbias", "uClearPolyID", "uClearDepth", "uEdgeFast", "uFogAlphaOnly"};
+    for (int i = 0; i < 6; i++)
+        EdgeFogULoc[i] = glGetUniformLocation(prog, names[i]);
+    FinalPassEdgeFogShader = prog;
+    Platform::Log(Platform::LogLevel::Info, "GLFINALPASS: combined edge and fog program built\n");
+    return true;
+}
+
+// the edge pass's uniforms (kFinalPassEdgeFS), in loc's order: uEdgeScale, uDepthUnbias, uClearPolyID,
+// uClearDepth, uEdgeFast
+void GLRenderer::SetEdgeUniforms(const GLint* loc, const GPU3D& gpu3d, bool wbuffer, int fast)
+{
+    glUniform1i(loc[0], ScaleFactor);
+    glUniform1f(loc[1], (wbuffer ? 255.0f : 512.0f) / 16777216.0f);
+    glUniform1i(loc[2], (gpu3d.RenderClearAttr1 >> 24) & 0x3F);
+    glUniform1f(loc[3], (float)(((gpu3d.RenderClearAttr2 & 0x7FFF) * 0x200) + 0x1FF) / 16777216.0f);
+    glUniform1i(loc[4], fast);
+}
