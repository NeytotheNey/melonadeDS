+// debug builds only, OpenGL renderer, GPU::SceneStats: the GLDEPTH log, on experiment R2
+// (GPU::GLDepth, docs/plan-gpu-discovery.md). the opaque polygons of W-buffer frames are sorted
+// whatever the switch is; the draws only show what it did.
+//
+// GLDEPTH, once a second, values per drawn frame (renders with polygons RenderFrame didn't skip):
+//   frames wframes gldepth
+//                      those frames, how many were W-buffered (the rest have nothing to sort), and the switch
+//   opaque             opaque polygons of W-buffer frames
+//   const lin frag     of those, the ones with one depth at every vertex (gldepth 1 and 2 draw them
+//                      without gl_FragDepth, exactly), the others gldepth 2 draws with linear depth
+//                      (WatermelonDS's rule, approximate), and the rest (textured, modulate, alpha 31,
+//                      repeat or flip, W not all equal), which keep gl_FragDepth in every mode
+//   const_area lin_area frag_area
+//                      their summed screen area over the screen's (native pixels, like SCENESTATS' od)
+//   draws_range draws_lin draws_frag
+//                      the opaque pass's draw calls by path, after batching
+struct GLDepthStats
+{
+    struct Counters
+    {
+        u32 Frames = 0, WFrames = 0;
+        u64 Opaque = 0, Const = 0, Lin = 0, Frag = 0;
+        double ConstArea = 0, LinArea = 0, FragArea = 0;
+        u64 DrawsRange = 0, DrawsLin = 0, DrawsFrag = 0;
+    };
+    Counters Sec;
+
+    // at the start of every RenderFrame
+    void FrameStart(s64 now, int mode)
+    {
+        if (LogStartNs == 0)
+            LogStartNs = now;
+        if (now - LogStartNs < 1000000000)
+            return;
+
+        if (Sec.Frames > 0)
+        {
+            double per = 1.0 / Sec.Frames;
+            Platform::Log(Platform::LogLevel::Info, "GLDEPTH frames=%u wframes=%u gldepth=%d opaque=%.1f const=%.1f "
+                "lin=%.1f frag=%.1f const_area=%.3f lin_area=%.3f frag_area=%.3f draws_range=%.1f draws_lin=%.1f "
+                "draws_frag=%.1f\n",
+                Sec.Frames, Sec.WFrames, mode, Sec.Opaque * per, Sec.Const * per, Sec.Lin * per, Sec.Frag * per,
+                Sec.ConstArea * per, Sec.LinArea * per, Sec.FragArea * per, Sec.DrawsRange * per,
+                Sec.DrawsLin * per, Sec.DrawsFrag * per);
+        }
+        Sec = {};
+        LogStartNs = now;
+    }
+
+private:
+    s64 LogStartNs = 0;
+};
+
 }
 
 #endif
