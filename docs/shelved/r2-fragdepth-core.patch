+// GPU::GLDepth (experiment R2), after BuildPolygons: how each opaque polygon of a W-buffer frame
+// gets its depth (RendererPolygon::DepthPath). the W-buffer program writes gl_FragDepth = fZ,
+// fZ = ((z << zshift) + bias) / 2^24 interpolated perspective-correctly, which keeps the GPU from
+// testing depth before the shader runs.
+// * DepthPath_Range (gldepth 1 and 2): every vertex the draw uses has the same z << zshift, so fZ
+//   is one value d at all of them (the same integer, the same float steps, each exact). the draw
+//   keeps today's gl_Position (z 0, so clipping and coverage don't change) and gets
+//   glDepthRangef(d, d), which makes the window depth of every fragment exactly
+//   0 * 0 + (d + d) / 2 = d, what gl_FragDepth = d stores. that holds as long as the GPU's
+//   perspective interpolation of a constant gives the constant back (true for interpolators that
+//   work from vertex differences; not promised by GL) and it converts shader and rasterized
+//   depth to 24 bits the same way. the DS has one depth over such a polygon too (the software
+//   renderer's InterpolateZ returns z0 when both ends are equal)
+// * DepthPath_Linear (gldepth 2 only): the rest, but for WatermelonDS's exceptions
+//   (GPU3D_Vulkan.cpp requiresWBufferFragmentDepth: textured, modulate, alpha 31, repeat or flip,
+//   W not the same at every vertex), which keep gl_FragDepth. fZ is then interpolated linearly in
+//   screen space, which is not what the W-buffer stores wherever W varies across the polygon, so
+//   depth tests, fog and hash3d can change: an upper bound for the A/B, not a candidate as is
+void GLRenderer::ClassifyDepthPaths(const GPU3D& gpu3d)
+{
+    bool stats = false;
+#ifdef MELONADE_DEBUG_TOOLS
+    stats = DepthStats != nullptr;
+#endif
+    bool wbuffer = gpu3d.RenderPolygonRAM[0]->WBuffer;
+#ifdef MELONADE_DEBUG_TOOLS
+    if (stats)
+    {
+        DepthStats->Sec.Frames++;
+        DepthStats->Sec.WFrames += wbuffer;
+    }
+#endif
+    if (!wbuffer || (!GLDepth && !stats))
+        return;
+
+    bool texturing = (gpu3d.RenderDispCnt & (1<<0)) != 0;
+    for (int i = 0; i < NumFinalPolys; i++)
+    {
+        RendererPolygon* rp = &PolygonList[i];
+        const Polygon* polygon = rp->PolyData;
+        if (polygon->IsShadowMask || polygon->Translucent)
+            continue;
+
+        // z << zshift of every vertex the draw uses, as SetupVertex wrote them (BetterPolygons'
+        // centre vertex too)
+        bool samez = rp->NumIndices > 0;
+        u32 z0 = 0;
+        for (u32 k = 0; k < rp->NumIndices; k++)
+        {
+            const u32* vtx = &VertexBuffer[IndexBuffer[rp->IndicesOffset + k] * 7];
+            u32 z = (vtx[1] & 0xFFFF) << ((vtx[4] >> 16) & 0x1F);
+            if (k == 0)
+                z0 = z;
+            else if (z != z0)
+            {
+                samez = false;
+                break;
+            }
+        }
+
+        int kind;
+        if (samez)
+            kind = DepthPath_Range;
+        else
+        {
+            bool samew = true;
+            for (u32 j = 1; j < polygon->NumVertices; j++)
+                samew &= polygon->FinalW[j] == polygon->FinalW[0];
+
+            u32 attr = polygon->Attr;
+            bool keep = texturing && ((polygon->TexParam >> 26) & 0x7) != 0
+                && ((attr >> 4) & 0x3) == 0 && ((attr >> 16) & 0x1F) == 31
+                && (polygon->TexParam & (0xF << 16)) != 0 && !samew;
+            kind = keep ? DepthPath_Frag : DepthPath_Linear;
+        }
+
+        if (kind == DepthPath_Range && GLDepth >= 1)
+        {
+            rp->DepthPath = DepthPath_Range;
+            rp->DepthZ = z0;
+        }
+        else if (kind == DepthPath_Linear && GLDepth >= 2)
+            rp->DepthPath = DepthPath_Linear;
+
+#ifdef MELONADE_DEBUG_TOOLS
+        if (stats)
+        {
+            GLDepthStats::Counters& sec = DepthStats->Sec;
+            s64 sum = 0;
+            u32 n = polygon->NumVertices;
+            for (u32 j = 0; j < n; j++)
+            {
+                const Vertex* a = polygon->Vertices[j];
+                const Vertex* b = polygon->Vertices[(j + 1) < n ? (j + 1) : 0];
+                sum += (s64)a->FinalPosition[0] * b->FinalPosition[1] - (s64)b->FinalPosition[0] * a->FinalPosition[1];
+            }
+            double area = (sum < 0 ? -sum : sum) / (2.0 * 256 * 192);
+
+            sec.Opaque++;
+            if (kind == DepthPath_Range)       { sec.Const++; sec.ConstArea += area; }
+            else if (kind == DepthPath_Linear) { sec.Lin++;   sec.LinArea += area; }
+            else                               { sec.Frag++;  sec.FragArea += area; }
+        }
+#endif
+    }
+}
